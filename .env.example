# Public port for the panel.
PANEL_PORT=8793

# First-run administrator. Existing data/ users are preserved after deployment.
SKU_BOARD_ADMIN_PASSWORD=replace-with-a-long-random-password

# Use HTTPS after Nginx + Certbot are ready; otherwise leave as 0.
SKU_BOARD_PUBLIC_URL=https://panel.example.com
SKU_BOARD_ALLOWED_ORIGIN=

# Used to encrypt saved Meta credential records in data/.
SKU_BOARD_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Shopline import.
SHOPLINE_API_BASE_URL=
SHOPLINE_ACCESS_TOKEN=
SHOPLINE_PRODUCTS_ENDPOINT=
SHOPLINE_ORDERS_ENDPOINT=
SHOPLINE_DEFAULT_CURRENCY=USD
SHOPLINE_MAX_ORDER_PAGES=10
# Click ID → Campaign mapping used by the attribution diagnostics panel.
# Example: {"fbclid:CLICK_ID":{"campaignId":"CAMPAIGN_ID","campaignName":"summer-sale"}}
SHOPLINE_CLICK_CAMPAIGN_MAP_JSON={}

# GA4 Data API. Grant the service-account email Viewer access to this property.
GA4_PROPERTY_ID=
GA4_KEY_EVENT_NAME=purchase
GA4_CONVERSION_METRIC=userKeyEventRate
GA4_CONVERSION_MODE=key_event_rate
GA4_SERVICE_ACCOUNT_FILE=
GA4_SERVICE_ACCOUNT_JSON=
GA4_TIMEOUT_SECONDS=30
DASHBOARD_CACHE_SECONDS=120

# Optional alert delivery. Manual "发送通知" uses this webhook immediately.
DASHBOARD_ALERT_WEBHOOK_URL=
DASHBOARD_ALERT_WEBHOOK_ON_SYNC=false

# chatgpt2api image nodes. Keep keys only in this .env file.
CHATGPT2API_IMAGE_USE_TASKS=true
CHATGPT2API_IMAGE_MODEL=gpt-image-2
CHATGPT2API_HEALTH_TIMEOUT=8
CHATGPT2API_IMAGE_TASK_SUBMIT_TIMEOUT=90
CHATGPT2API_IMAGE_TASK_TIMEOUT=180
CHATGPT2API_IMAGE_TASK_BATCH_SIZE=2
CHATGPT2API_IMAGE_TASK_POLL_INTERVAL=1
CHATGPT2API_IMAGE_TRANSIENT_RETRIES=1
CHATGPT2API_HEDGE_NODE_COUNT=2
CHATGPT2API_PANEL_MAX_ACTIVE_REQUESTS=4
CHATGPT2API_PANEL_MAX_ACTIVE_PER_USER=1
CHATGPT2API_DISABLED_NODE_IDS=
CHATGPT2API_IMAGE_MAX_COUNT=10
CHATGPT2API_UNHEALTHY_NODE_COOLDOWN=180
CHATGPT2API_NODES_JSON=[]

# Giikin Acore company image provider. Use a personal dk-ai-p key.
ACORE_IMAGE_ENABLED=false
ACORE_IMAGE_BASE_URL=https://api.giikin.com/acore/model/v1
ACORE_IMAGE_AUTH_KEY=
ACORE_IMAGE_SUBMIT_TIMEOUT=60
ACORE_IMAGE_TASK_TIMEOUT=600
ACORE_IMAGE_POLL_INTERVAL=3
ACORE_IMAGE_MAX_WORKERS=3

# Director / product analysis model.
AI_DIRECTOR_ENABLED=true
AI_DIRECTOR_API_BASE_URL=
AI_DIRECTOR_API_KEY=
AI_DIRECTOR_MODEL=gpt-5.6-terra
AI_DIRECTOR_FALLBACK_MODELS=gpt-5.6-terra,gpt-5.6-sol
AI_DIRECTOR_TIMEOUT=60
AI_DIRECTOR_ATTEMPT_TIMEOUT=40
AI_DIRECTOR_TOTAL_TIMEOUT=80
AI_DIRECTOR_USE_ENV_PROXY=false
AI_DIRECTOR_VISION_ENABLED=true
OPEN_IMAGE_PROMPTS_ENABLED=true
# Optional override. Default: ./open-image-prompts
OPEN_IMAGE_PROMPTS_ROOT=
AI_DIRECTOR_REVIEW_ENABLED=true
AI_DIRECTOR_REVIEW_THRESHOLD=78
# Optional post-render Japanese headline overlay. Keep false to avoid duplicate text;
# enable only when every requested page needs an application-typeset headline.
AI_IMAGE_PRECISE_TYPOGRAPHY_ENABLED=false
AI_IMAGE_REMOTE_STORAGE=false
AI_IMAGE_OUTPUT_TTL_SECONDS=604800
AI_IMAGE_REMOTE_PREVIEW_RETRIES=1
AI_IMAGE_REMOTE_PREVIEW_CONNECT_TIMEOUT=5
AI_IMAGE_REMOTE_PREVIEW_READ_TIMEOUT=20

# Meta OAuth. Set these when binding Meta accounts from the panel.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://panel.example.com/api/sku-board/meta-oauth/callback
META_GRAPH_API_VERSION=v23.0

# Optional Meta launch defaults.
FB_PAGE_ID=
FB_INSTAGRAM_ACTOR_ID=
SOSOVE_PRODUCT_URL_BASE=https://example.com/products/
FB_DEFAULT_COUNTRY=JP
FB_DEFAULT_DAILY_BUDGET=10

# Optional Linux-side Meta analysis script path.
SKU_BOARD_META_AD_ANALYSIS_SCRIPT=
