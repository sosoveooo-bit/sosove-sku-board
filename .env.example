# Public port for the panel.
PANEL_PORT=8793

# First-run administrator. Existing data/ users are preserved after deployment.
SKU_BOARD_ADMIN_PASSWORD=replace-with-a-long-random-password

# Use HTTPS after Nginx + Certbot are ready; otherwise leave as 0.
SKU_BOARD_PUBLIC_URL=https://panel.example.com
SKU_BOARD_ALLOWED_ORIGIN=

# Used to encrypt saved Meta credential records in data/.
SKU_BOARD_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Shopline import.
SHOPLINE_API_BASE_URL=
SHOPLINE_ACCESS_TOKEN=
SHOPLINE_PRODUCTS_ENDPOINT=
SHOPLINE_ORDERS_ENDPOINT=
SHOPLINE_DEFAULT_CURRENCY=USD
SHOPLINE_MAX_ORDER_PAGES=10

# chatgpt2api image nodes. Keep keys only in this .env file.
CHATGPT2API_IMAGE_USE_TASKS=true
CHATGPT2API_IMAGE_MODEL=gpt-image-2
CHATGPT2API_HEALTH_TIMEOUT=8
CHATGPT2API_IMAGE_TASK_SUBMIT_TIMEOUT=90
CHATGPT2API_IMAGE_TASK_TIMEOUT=600
CHATGPT2API_IMAGE_TASK_BATCH_SIZE=2
CHATGPT2API_IMAGE_TASK_POLL_INTERVAL=1
CHATGPT2API_IMAGE_TRANSIENT_RETRIES=3
CHATGPT2API_PANEL_MAX_ACTIVE_REQUESTS=4
CHATGPT2API_PANEL_MAX_ACTIVE_PER_USER=2
CHATGPT2API_DISABLED_NODE_IDS=
CHATGPT2API_IMAGE_MAX_COUNT=10
CHATGPT2API_UNHEALTHY_NODE_COOLDOWN=180
CHATGPT2API_NODES_JSON=[]

# Director / product analysis model.
AI_DIRECTOR_ENABLED=true
AI_DIRECTOR_API_BASE_URL=
AI_DIRECTOR_API_KEY=
AI_DIRECTOR_MODEL=gpt-5.6-terra
AI_DIRECTOR_FALLBACK_MODELS=gpt-5.6-terra,gpt-5.6-sol
AI_DIRECTOR_TIMEOUT=60
AI_DIRECTOR_VISION_ENABLED=true
AI_DIRECTOR_REVIEW_ENABLED=true
AI_DIRECTOR_REVIEW_THRESHOLD=78

# Meta OAuth. Set these when binding Meta accounts from the panel.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://panel.example.com/api/sku-board/meta-oauth/callback
META_GRAPH_API_VERSION=v23.0

# Optional Meta launch defaults.
FB_PAGE_ID=
FB_INSTAGRAM_ACTOR_ID=
SOSOVE_PRODUCT_URL_BASE=https://example.com/products/
FB_DEFAULT_COUNTRY=JP
FB_DEFAULT_DAILY_BUDGET=10

# Optional Linux-side Meta analysis script path.
SKU_BOARD_META_AD_ANALYSIS_SCRIPT=
